const REGISTRATION_HTML = "<!doctype html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#163c58\">\n  <title>التسجيل في ورشة منصة العمل التطوعي | إمارة منطقة تبوك</title>\n  <style>\n    :root{font-family:system-ui,-apple-system,\"Segoe UI\",Tahoma,sans-serif;color:#163047;background:#eef3f5}*{box-sizing:border-box}body{margin:0}button,input,textarea{font:inherit}button{cursor:pointer}header{background:#123d58;color:white;padding:26px max(20px,calc((100vw - 900px)/2));border-bottom:5px solid #bba06a}header .eyebrow{font-size:14px;color:#dce9ed}h1{font-size:clamp(24px,4vw,36px);line-height:1.35;margin:8px 0 5px}header p{margin:0;color:#e3edef}main{max-width:900px;margin:24px auto 60px;padding:0 16px}.shell{background:#fff;border:1px solid #d8e3e9;border-radius:22px;padding:clamp(20px,4vw,36px);box-shadow:0 12px 35px #193e5312}.topline{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:9px}.topline strong{font-size:16px}.topline span{font-size:14px;color:#547185}.track{height:7px;border-radius:30px;background:#dce7eb;overflow:hidden}.fill{height:100%;width:25%;background:#bd9c61;transition:width .25s}.step{display:none}.step.active{display:block}.step h2{font-size:23px;margin:28px 0 6px}.hint{color:#526d7c;margin:0 0 22px;line-height:1.6}.field{border:0;margin:0 0 24px;padding:0}.field legend{font-size:16px;font-weight:650;line-height:1.5;margin-bottom:10px}.req{color:#a14632}.textinput{width:100%;border:1px solid #bacbd4;border-radius:12px;padding:13px 15px;background:#fff;color:#163047;min-height:50px}.textinput:focus,.choice:focus-within{outline:3px solid #a8c9d5;outline-offset:2px}.choices{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:9px}.choice{border:1px solid #cbd9df;border-radius:12px;min-height:48px;padding:11px 12px;display:flex;align-items:center;gap:9px;cursor:pointer;line-height:1.45}.choice:has(input:checked){border-color:#146187;background:#eaf4f8}.choice input{accent-color:#146187;width:18px;height:18px;flex:none}.scale{display:flex;gap:7px;flex-wrap:wrap}.scale .choice{min-width:54px;justify-content:center;padding:8px}.scale .choice input{position:absolute;opacity:0;width:1px;height:1px}.bounds{display:flex;justify-content:space-between;max-width:360px;color:#536e7d;font-size:14px;margin-top:6px}.actions{display:flex;justify-content:space-between;gap:12px;border-top:1px solid #e3ecef;padding-top:22px;margin-top:10px}.btn{border:0;border-radius:11px;background:#135f81;color:white;padding:12px 24px;min-height:48px;font-weight:650}.btn:disabled{opacity:.6;cursor:wait}.secondary{background:#e8eff2;color:#21455a}.error{color:#9e342e;background:#fff0ee;border-radius:10px;padding:10px 14px;margin:14px 0;display:none}.success{text-align:center;padding:35px 8px}.success .icon{font-size:42px;color:#248270}.success h2{font-size:27px}.success p{line-height:1.7;color:#536e7d}.small{font-size:13px;color:#5d7480;margin-top:17px}a{color:#135f81}@media(max-width:560px){.choices{grid-template-columns:1fr}.scale{justify-content:space-between}.scale .choice{flex:1;min-width:0}.actions .btn{flex:1}}\n  </style>\n</head>\n<body>\n<header><div class=\"eyebrow\">إمارة منطقة تبوك · العمل التطوعي</div><h1>ورشة تحديثات منصة العمل التطوعي</h1><p>استبانة قياس المعرفة والاحتياجات قبل الورشة</p></header>\n<main><div class=\"shell\" id=\"formShell\"><div class=\"topline\"><strong id=\"stepName\">البيانات الأساسية</strong><span id=\"counter\">الخطوة ١ من ٤</span></div><div class=\"track\" aria-hidden=\"true\"><div class=\"fill\" id=\"fill\"></div></div><form id=\"registration\" novalidate><div id=\"steps\"></div><div class=\"error\" id=\"error\" role=\"alert\"></div><div class=\"actions\"><button type=\"button\" class=\"btn secondary\" id=\"back\" hidden>السابق</button><button type=\"button\" class=\"btn\" id=\"next\">التالي</button></div></form><p class=\"small\">تُحفظ إجاباتك في جدول التسجيل بعد الضغط على «إرسال الإجابات».</p></div><section class=\"shell success\" id=\"success\" hidden><div class=\"icon\">✓</div><h2>شكرًا لتسجيلك</h2><p>تم حفظ بياناتك في جدول التسجيل. يمكنك إغلاق الصفحة الآن.</p></section></main>\n\n<script>\nconst fields=[{\"label\":\"الاسم كامل:\",\"entry\":\"1857687044\",\"required\":true,\"type\":0},{\"label\":\"رقم الجوال\",\"entry\":\"50109027\",\"required\":true,\"type\":0},{\"label\":\"البريد الإلكتروني\",\"entry\":\"245833343\",\"required\":true,\"type\":0},{\"label\":\"الجهة / الإدارة\",\"entry\":\"1947524408\",\"required\":false,\"type\":0},{\"label\":\"الفئة\",\"entry\":\"2035022963\",\"required\":true,\"type\":2,\"options\":[\"موظف/ـة\",\"متطوع/ـة\",\"مهتم بالعمل التطوعي\"],\"other\":true},{\"label\":\"هل سبق لك التسجيل في المنصة الوطنية للعمل التطوعي؟\",\"entry\":\"1817991851\",\"required\":true,\"type\":2,\"options\":[\"نعم\",\"لا\"],\"other\":false},{\"label\":\"هل سبق لك المشاركة في فرصة تطوعية من خلال المنصة؟\",\"entry\":\"1320532521\",\"required\":true,\"type\":2,\"options\":[\"نعم\",\"لا\"],\"other\":false},{\"label\":\"أتعرف على طريقة الدخول إلى المنصة\",\"entry\":\"1482563673\",\"required\":true,\"type\":5,\"options\":[\"1\",\"2\",\"3\",\"4\",\"5\"],\"other\":false,\"bounds\":[\"لا اعرف \",\"ممتاز \"]},{\"label\":\"أعرف كيفية تحديث بياناتي الشخصية\",\"entry\":\"1644725631\",\"required\":true,\"type\":5,\"options\":[\"1\",\"2\",\"3\",\"4\",\"5\"],\"other\":false,\"bounds\":[\"لا اعرف \",\"ممتاز \"]},{\"label\":\"أعرف كيفية البحث عن الفرص التطوعية\",\"entry\":\"1230340556\",\"required\":true,\"type\":5,\"options\":[\"1\",\"2\",\"3\",\"4\",\"5\"],\"other\":false,\"bounds\":[\"لا اعرف \",\"ممتاز \"]},{\"label\":\"أعرف كيفية التسجيل في فرصة تطوعية\",\"entry\":\"922687665\",\"required\":true,\"type\":5,\"options\":[\"1\",\"2\",\"3\",\"4\",\"5\"],\"other\":false,\"bounds\":[\"لا اعرف \",\"ممتاز \"]},{\"label\":\"أعرف كيفية متابعة الفرص التي سجلت بها\",\"entry\":\"671403525\",\"required\":true,\"type\":5,\"options\":[\"1\",\"2\",\"3\",\"4\",\"5\"],\"other\":false,\"bounds\":[\"لا اعرف \",\"ممتاز \"]},{\"label\":\"أعرف كيفية توثيق الساعات التطوعية\",\"entry\":\"1653180075\",\"required\":true,\"type\":5,\"options\":[\"1\",\"2\",\"3\",\"4\",\"5\"],\"other\":false,\"bounds\":[\"لا اعرف \",\"ممتاز \"]},{\"label\":\"أعرف كيفية الاطلاع على سجل مشاركاتي التطوعية\",\"entry\":\"783944499\",\"required\":true,\"type\":5,\"options\":[\"1\",\"2\",\"3\",\"4\",\"5\"],\"other\":false,\"bounds\":[\"لا اعرف \",\"ممتاز \"]},{\"label\":\"أعرف كيفية الحصول على الشهادات التطوعية\",\"entry\":\"1031300689\",\"required\":true,\"type\":5,\"options\":[\"1\",\"2\",\"3\",\"4\",\"5\"],\"other\":false,\"bounds\":[\"لا اعرف \",\"ممتاز \"]},{\"label\":\"لدي معرفة بالتحديثات الجديدة في المنصة\",\"entry\":\"136243343\",\"required\":true,\"type\":5,\"options\":[\"1\",\"2\",\"3\",\"4\",\"5\"],\"other\":false,\"bounds\":[\"لا اعرف \",\"ممتاز \"]},{\"label\":\"ما مدى معرفتك بالتحديثات الجديدة في المنصة؟\",\"entry\":\"1765637807\",\"required\":true,\"type\":2,\"options\":[\"معرفة كاملة\",\"معرفة جيدة\",\"معرفة محدودة\",\"لا اعرف عنها شيئا\"],\"other\":false},{\"label\":\"ما أكثر جانب ترغب في معرفة تفاصيله خلال الورشة؟\",\"entry\":\"663533952\",\"required\":true,\"type\":2,\"options\":[\"الملف الشخصي\",\"البحث عن الفرص\",\"التسجيل في الفرص\",\"إدارة المشاركات\",\"توثيق الساعات\",\"الشهادات والتوثيق\",\"الخدمات والتحديثات الجديدة\",\"خيار 8\"],\"other\":false},{\"label\":\"ما أبرز الصعوبات التي تواجهك عند استخدام المنصة؟\",\"entry\":\"360709053\",\"required\":true,\"type\":2,\"options\":[\"الدخول والتسجيل\",\"البحث عن الفرص\",\"التسجيل في الفرص\",\"متابعة الساعات\",\"توثيق الساعات\",\"الشهادات\",\"لا توجد صعوبات\"],\"other\":true},{\"label\":\"ما مستوى استخدامك للمنصة؟\",\"entry\":\"1209453647\",\"required\":true,\"type\":2,\"options\":[\"مستمر\",\"احيانا\",\"استخدمتها سابقا\",\"مسجل ولم استخدمها\"],\"other\":true},{\"label\":\"ما الذي تتوقع أن تستفيد منه بعد حضور الورشة؟\",\"entry\":\"854611107\",\"required\":true,\"type\":2,\"options\":[\"التحديثات الجديدة\",\"الاستخدام الصحيح\",\"التسجيل في الفرص\",\"إدارة الساعات و المشاركات\",\"الخدمات الالكترونية\",\"حل المشكلات\"],\"other\":true},{\"label\":\"ما الموضوع أو السؤال الذي ترغب في طرحه خلال الورشة؟\",\"entry\":\"2011053240\",\"required\":false,\"type\":0}];\nconst labels=['البيانات الأساسية','تجربتك مع المنصة','تقييم معرفتك','احتياجات الورشة'];\nlet step=0,sending=false;\nconst form=document.querySelector('#registration'),steps=document.querySelector('#steps'),error=document.querySelector('#error');\nfunction el(tag,cls,text){const n=document.createElement(tag);if(cls)n.className=cls;if(text!==undefined)n.textContent=text;return n}\nfunction group(i){return i<7?0:i<16?2:3} // أول سبعة أسئلة تشمل البيانات والتجربة؛ يُعاد توزيعها أدناه.\nfunction section(i){return i<5?0:i<7?1:i<16?2:3}\nfunction buildField(f,i){const box=el('fieldset','field');box.dataset.field=i;const legend=el('legend','',f.label);if(f.required)legend.append(el('span','req',' *'));box.append(legend);\n  if(f.type===0){const input=el('input','textinput');input.type=i===1?'tel':i===2?'email':'text';input.autocomplete=i===0?'name':i===1?'tel':i===2?'email':'off';input.dir='auto';input.name='entry.'+f.entry;input.required=f.required;if(i===1){input.inputMode='tel';input.pattern='[0-9+\\\\s-]{8,18}'}box.append(input)}\n  else{const list=el('div',f.type===5?'scale':'choices');f.options.forEach(o=>{const label=el('label','choice');const input=el('input');input.type='radio';input.name='entry.'+f.entry;input.value=o;input.required=f.required;label.append(input,el('span','',o));list.append(label)});box.append(list);\n    if(f.type===5){const bounds=el('div','bounds');bounds.append(el('span','',f.bounds?.[0]||'لا أعرف'),el('span','',f.bounds?.[1]||'ممتاز'));box.append(bounds)}\n    if(f.other){const other=el('input','textinput');other.type='text';other.placeholder='خيار آخر (اختياري)';other.setAttribute('aria-label','خيار آخر: '+f.label);other.style.marginTop='10px';other.addEventListener('input',()=>{if(other.value.trim())box.querySelectorAll('input[type=radio]').forEach(r=>r.checked=false)});box.append(other)}\n  }return box}\nfunction show(){document.querySelectorAll('.step').forEach((n,i)=>n.classList.toggle('active',i===step));document.querySelector('#stepName').textContent=labels[step];document.querySelector('#counter').textContent=`الخطوة ${step+1} من ٤`;document.querySelector('#fill').style.width=((step+1)*25)+'%';document.querySelector('#back').hidden=step===0;document.querySelector('#next').textContent=step===3?'إرسال الإجابات':'التالي';error.style.display='none';window.scrollTo({top:0,behavior:'smooth'})}\nfunction validate(){const panel=document.querySelectorAll('.step')[step];for(const box of panel.querySelectorAll('.field')){const text=box.querySelector('input.textinput:not([placeholder])');const radios=[...box.querySelectorAll('input[type=radio]')];const other=box.querySelector('input[placeholder]');let valid=true;if(text){valid=!text.required||text.validity.valid}else if(fields[+box.dataset.field].required){valid=radios.some(r=>r.checked)||!!other?.value.trim()}if(!valid){error.textContent='يرجى إكمال الحقل المطلوب: '+fields[+box.dataset.field].label;error.style.display='block';(text||radios[0]||other).focus();return false}}return true}\nfunction submit(){\n  if(sending)return;\n  if(!(window.google&&google.script&&google.script.run)){\n    error.textContent='افتحي رابط الموقع المنشور من Apps Script ثم حاولي مرة أخرى.';\n    error.style.display='block';return;\n  }\n  sending=true;\n  const btn=document.querySelector('#next');btn.disabled=true;btn.textContent='جارٍ حفظ التسجيل…';error.style.display='none';\n  const answers=fields.map((f,i)=>{\n    const box=document.querySelector(`[data-field=\"${i}\"]`);\n    const other=box.querySelector('input[placeholder]')?.value.trim();\n    return other||box.querySelector('input[type=radio]:checked')?.value||box.querySelector('input.textinput:not([placeholder])')?.value.trim()||'';\n  });\n  google.script.run.withSuccessHandler(result=>{\n    sending=false;\n    if(!result||result.ok!==true){showError(result?.message||'لم يُحفظ التسجيل. حاولي مجددًا.');return}\n    document.querySelector('#formShell').hidden=true;\n    document.querySelector('#success').hidden=false;\n    window.scrollTo(0,0);\n  }).withFailureHandler(err=>{\n    sending=false;\n    showError(err?.message||'تعذّر الاتصال بالشيت. حاولي مجددًا.');\n  }).saveRegistration(answers);\n}\nfunction showError(message){\n  const btn=document.querySelector('#next');btn.disabled=false;btn.textContent='إعادة المحاولة';\n  error.textContent=message;error.style.display='block';\n}\nform.addEventListener('submit',e=>{e.preventDefault();if(!validate())return;if(step<3){step++;show()}else submit()});\ndocument.querySelector('#next').addEventListener('click',()=>{if(!validate())return;if(step<3){step++;show()}else submit()});document.querySelector('#back').addEventListener('click',()=>{step--;show()});\nlabels.forEach((name,i)=>{\n  const pane=el('section','step');pane.dataset.step=i;\n  pane.append(el('h2','',name),el('p','hint',[\n    'أدخل بياناتك لنتمكن من التواصل بشأن الورشة.',\n    'أخبرنا عن تجربتك السابقة مع المنصة.',\n    'اختر درجة معرفتك من ١ إلى ٥ لكل عبارة.',\n    'ساعدنا في تحديد ما تحتاجه خلال الورشة.'\n  ][i]));\n  fields.forEach((f,j)=>{if(section(j)===i)pane.append(buildField(f,j))});\n  steps.append(pane);\n});\nshow();\n</script>\n</body></html>\n";

// يحفظ ردود الموقع في الصفحة الأولى من ملف Google Sheets الجديد.
const SPREADSHEET_ID = '1r3BrP8VQozBY6290gbM0AYYntZWwpOVtW7lvXyv9w7w';
const WEBSITE_SHEET_ID = 0;
const WEBSITE_SHEET_NAME = 'تسجيلات الموقع';
const QUESTIONS = [{"label":"الاسم كامل:","entry":"1857687044","required":true},{"label":"رقم الجوال","entry":"50109027","required":true},{"label":"البريد الإلكتروني","entry":"245833343","required":true},{"label":"الجهة / الإدارة","entry":"1947524408","required":false},{"label":"الفئة","entry":"2035022963","required":true},{"label":"هل سبق لك التسجيل في المنصة الوطنية للعمل التطوعي؟","entry":"1817991851","required":true},{"label":"هل سبق لك المشاركة في فرصة تطوعية من خلال المنصة؟","entry":"1320532521","required":true},{"label":"أتعرف على طريقة الدخول إلى المنصة","entry":"1482563673","required":true},{"label":"أعرف كيفية تحديث بياناتي الشخصية","entry":"1644725631","required":true},{"label":"أعرف كيفية البحث عن الفرص التطوعية","entry":"1230340556","required":true},{"label":"أعرف كيفية التسجيل في فرصة تطوعية","entry":"922687665","required":true},{"label":"أعرف كيفية متابعة الفرص التي سجلت بها","entry":"671403525","required":true},{"label":"أعرف كيفية توثيق الساعات التطوعية","entry":"1653180075","required":true},{"label":"أعرف كيفية الاطلاع على سجل مشاركاتي التطوعية","entry":"783944499","required":true},{"label":"أعرف كيفية الحصول على الشهادات التطوعية","entry":"1031300689","required":true},{"label":"لدي معرفة بالتحديثات الجديدة في المنصة","entry":"136243343","required":true},{"label":"ما مدى معرفتك بالتحديثات الجديدة في المنصة؟","entry":"1765637807","required":true},{"label":"ما أكثر جانب ترغب في معرفة تفاصيله خلال الورشة؟","entry":"663533952","required":true},{"label":"ما أبرز الصعوبات التي تواجهك عند استخدام المنصة؟","entry":"360709053","required":true},{"label":"ما مستوى استخدامك للمنصة؟","entry":"1209453647","required":true},{"label":"ما الذي تتوقع أن تستفيد منه بعد حضور الورشة؟","entry":"854611107","required":true},{"label":"ما الموضوع أو السؤال الذي ترغب في طرحه خلال الورشة؟","entry":"2011053240","required":false}];

function doGet() {
  return HtmlService.createHtmlOutput(REGISTRATION_HTML)
    .setTitle('ورشة تحديثات منصة العمل التطوعي')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function normalizeHeader_(value) {
  return String(value || '').replace(/[\u064B-\u065F\u0670\u0640]/g, '')
    .replace(/[أإآ]/g, 'ا').replace(/ى/g, 'ي').replace(/ة/g, 'ه')
    .replace(/[^\p{L}\p{N}]/gu, '').toLowerCase();
}

function safeCell_(value) {
  const text = String(value == null ? '' : value).trim();
  if (text.length > 5000) throw new Error('إحدى الإجابات طويلة جدًا.');
  // منع تحويل إجابات المستخدم إلى صيغ في Google Sheets.
  return /^[=+@-]/.test(text) ? "'" + text : text;
}

function saveRegistration(answers) {
  if (!Array.isArray(answers) || answers.length !== QUESTIONS.length) {
    throw new Error('بيانات التسجيل غير مكتملة. حدّثي الصفحة وحاولي مرة أخرى.');
  }
  const cleaned = answers.map(safeCell_);
  QUESTIONS.forEach((q, i) => {
    if (q.required && !cleaned[i]) throw new Error('يرجى إكمال الحقل المطلوب: ' + q.label);
  });
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetById(WEBSITE_SHEET_ID);
    if (!sheet) throw new Error('لم يُعثر على الصفحة الأولى في الشيت الجديد.');
    const expectedHeaders = ['تاريخ التسجيل', ...QUESTIONS.map(q => q.label)];
    if (sheet.getLastRow() === 0) {
      sheet.setName(WEBSITE_SHEET_NAME);
      sheet.appendRow(expectedHeaders);
      sheet.setFrozenRows(1);
      sheet.setRightToLeft(true);
    } else {
      const actual = sheet.getRange(1, 1, 1, expectedHeaders.length).getDisplayValues()[0];
      if (actual.some((header, i) => normalizeHeader_(header) !== normalizeHeader_(expectedHeaders[i]))) {
        throw new Error('عناوين تبويب تسجيلات الموقع تغيرت. أعيديها كما كانت ثم حاولي مجددًا.');
      }
    }
    sheet.appendRow([new Date(), ...cleaned]);
    SpreadsheetApp.flush();
    return { ok: true };
  } finally {
    lock.releaseLock();
  }
}
